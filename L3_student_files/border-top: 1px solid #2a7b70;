/* DEV.140 · Homework 2 example stylesheet */
* {
  box-sizing: border-box;
}

body {
  font-family: 'Inter', sans-serif;
  font-size: 18px;
  line-height: 1.6;
  background-color: #fcfcfc;
  color: #112040;
  margin: 0;
}

h1, h2, h3 {
  font-family: 'Poppins', sans-serif;
}

h1 {
  color: #00998f;
  margin: 0;
}

main {
  padding: 0 24px;
}

p {
  font-size: 18px;
}

.note {
  color: #bc000071;
}

#hero {
  background-color: #e8ffe7;
  padding: 32px;
  margin-bottom: 32px;
}

header {
  padding: 24px;
  border-bottom: 4px solid #0e9c93;
  margin-bottom: 32px;
}

.card {
  background-color: #a5a5a5;
  border: 2px solid #4a77d9;
  padding: 24px;
  margin-bottom: 24px;
}

footer {
  padding: 16px 24px;
  border-top: 1px solid #2a7b70;
  margin-top: 32px;
}
